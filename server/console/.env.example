# Vite dev server proxies /api to this target. Default points at the mock server
# (pnpm mock). Point it at a real server for integration work:
#   VITE_DEV_API_TARGET=http://127.0.0.1:6688
VITE_DEV_API_TARGET=http://127.0.0.1:9200

# Browser-facing API prefix. Keep /api so nginx can proxy it; set an absolute URL
# only when serving the SPA on a different origin than the API.
VITE_API_BASE_URL=/api

# Product name shown in the sidebar and page title.
VITE_INSTANCE_NAME=Mem0

# Fallback for servers that do not set an httpOnly refresh cookie: store the
# refresh token in sessionStorage instead. Leave off for the recommended setup.
VITE_REFRESH_TOKEN_FALLBACK=false
