OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
# Required: mem0-server refuses to start when this is empty (generate with `openssl rand -hex 32`).
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# --- Web 控制台（server/console，Vite SPA；由 nginx 同源反代 /api/* -> /*） ---
# 刷新令牌的 httpOnly cookie 名，默认 mem0_console_rt。
# /auth/register、/auth/login、/auth/refresh 成功时写入该 cookie（30 天），
# /auth/refresh 在 body 未提供 refresh_token 时读取它，/auth/logout 清除它。
# 响应体仍然返回 access_token/refresh_token，旧 dashboard 的写法不受影响。
CONSOLE_COOKIE_NAME=mem0_console_rt
# cookie 是否带 Secure。留空时不设置，按 DASHBOARD_URL 是否以 https:// 开头自动推断；
# 反向代理终结 TLS 的生产部署建议显式设为 true（浏览器只回传 Secure cookie 给 https）。
CONSOLE_COOKIE_SECURE=
# 额外允许携带凭据访问 API 的浏览器来源，逗号分隔（如 http://localhost:5173）。
# 会与 DASHBOARD_URL 合并去重；同源 nginx 反代部署通常留空。
# 切勿填 "*"：allow_credentials=True 时通配来源会被忽略并打印告警。
CORS_ORIGINS=

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# OFF by default in this fork; set to true to opt in.
MEM0_TELEMETRY=false

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
