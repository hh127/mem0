# ============================================
# Mem0 部署配置 - 复制为 .env 后修改
# ============================================

# === NAS IP（Dashboard 用这个地址连 API） ===
NAS_IP=192.168.4.132

# === PostgreSQL ===
POSTGRES_USER=mem0
POSTGRES_PASSWORD=change_me_pg_password_123
POSTGRES_DB=mem0

# === LLM（记忆提取用的大模型） ===
# 注意: server 读的是 LLM_BASE_URL（不是 OPENAI_BASE_URL，后者是无效的）。
OPENAI_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
MEM0_DEFAULT_LLM_MODEL=deepseek-chat

# === Embedding（文本向量化） ===
# 维度必须与向量库 collection 一致，换模型要重建 collection。
EMBEDDER_API_KEY=your_embedder_key_here
EMBEDDER_BASE_URL=https://api.siliconflow.cn/v1
MEM0_DEFAULT_EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDING_DIMS=1024

# 走本机 Ollama 时的等价写法（另一套环境可参考，不要和上面同时用）
# LLM_BASE_URL=http://host.docker.internal:6600/v1
# MEM0_DEFAULT_LLM_MODEL=MiniMax-M2.7
# EMBEDDER_BASE_URL=http://host.docker.internal:11434/v1
# MEM0_DEFAULT_EMBEDDER_MODEL=bge-m3:latest
# EMBEDDING_DIMS=1024

# === Reranker（可选，仅 search(rerank=true) 时生效） ===
# provider=cloud_reranker 接任意第三方 /v1/rerank 接口（硅基流动 / Jina / DashScope / Cohere 风格）。
# 不配则完全关闭，search 照常工作只是不重排。也可以改用 RERANKER_CONFIG_JSON 传完整 JSON。
# RERANKER_PROVIDER=cloud_reranker
# RERANKER_BASE_URL=https://api.siliconflow.cn/v1
# RERANKER_API_KEY=your_rerank_key_here
# MEM0_DEFAULT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_TOP_K=3

# === 记忆语言 ===
# v3 抽取提示词不含语言约束，不设置则可能输出英文。
# MEM0_CUSTOM_INSTRUCTIONS=无论对话使用何种语言，记忆内容必须始终用简体中文书写，严禁翻译成英文。

# === 认证 ===
ADMIN_API_KEY=change_me_admin_key_16chars
JWT_SECRET=change_me_jwt_secret_16chars
AUTH_DISABLED=true

# === 其他 ===
# 官方遥测：本仓库默认关闭（代码层默认 false，且 mem0 库的 MEM0_TELEMETRY 也在 main.py 里兜底关掉）。
# 想上报就写 true，否则保持 false 或不写都行。
MEM0_TELEMETRY=false
# LLM「缓存命中」推断窗口（小时）：服务商不回缓存字段时，窗口内出现过相同 prompt 视为命中缓存。
MEM0_CACHE_WINDOW_HOURS=6
REQUEST_LOG_RETENTION_DAYS=30
